@page "/"

@using FitParser.Web.Models
@using FitParser.Web.Services
@using Microsoft.AspNetCore.Components.Forms

@inject FitParserApiClient ApiClient

<PageTitle>FIT Parser</PageTitle>

<div class="container mt-5">
    <h1>FIT Parser</h1>

    <p class="text-muted">
        Upload a Garmin FIT file to inspect its messages and fields.
    </p>

    <div class="card shadow-sm p-4">
        <h2>Select a FIT File</h2>

        <InputFile OnChange="HandleFileSelected"
                   accept=".fit" />

        @if (selectedFile is not null)
        {
            <p class="mt-3">
                Selected file:
                <strong>@selectedFile.Name</strong>
            </p>

            <button class="btn btn-primary"
                    @onclick="AnalyzeFileAsync"
                    disabled="@isAnalyzing">

                @if (isAnalyzing)
                {
                    <span>Analyzing...</span>
                }
                else
                {
                    <span>Analyze File</span>
                }
            </button>
        }
    </div>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger mt-4">
            @errorMessage
        </div>
    }

    @if (analysisResult is not null)
    {
        <div class="card shadow-sm mt-4">
            <div class="card-header">
                <h2>Analysis Results</h2>
            </div>

            <div class="card-body">
                <div class="row">
                    <div class="col-md-4">
                        <strong>File Name</strong>
                        <p>@analysisResult.FileName</p>
                    </div>

                    <div class="col-md-4">
                        <strong>File ID</strong>
                        <p>@analysisResult.FileId</p>
                    </div>

                    <div class="col-md-4">
                        <strong>Message Types</strong>
                        <p>@analysisResult.MessageCount</p>
                    </div>
                </div>

                <hr />

                <h2>Messages</h2>

                @if (analysisResult.Messages.Count == 0)
                {
                    <p class="text-muted">
                        No messages were found in this file.
                    </p>
                }
                else
                {
                    @foreach (MessageResponse message in analysisResult.Messages)
                    {
                        <div class="card mt-3">
                            <div class="card-header">
                                <div class="d-flex justify-content-between">
                                    <span>
                                        <strong>@message.MessageName</strong>
                                        <span class="text-muted">
                                            Message Number:
                                            @message.MessageNumber
                                        </span>
                                    </span>

                                    <span>
                                        Occurrences:
                                        @message.Occurrences
                                    </span>
                                </div>
                            </div>

                            <div class="card-body">
                                <h3>Fields</h3>

                                @if (message.Fields.Count == 0)
                                {
                                    <p class="text-muted">
                                        No fields were found for this message.
                                    </p>
                                }
                                else
                                {
                                    <table class="table table-striped table-bordered">
                                        <thead>
                                            <tr>
                                                <th>Field Number</th>
                                                <th>Field Name</th>
                                                <th>Occurrences</th>
                                            </tr>
                                        </thead>

                                        <tbody>
                                            @foreach (FieldResponse field in message.Fields)
                                            {
                                                <tr>
                                                    <td>@field.FieldNumber</td>
                                                    <td>@field.FieldName</td>
                                                    <td>@field.Occurrences</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                }
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    }
</div>

@code {
    private IBrowserFile? selectedFile;

    private AnalyzeFitResponse? analysisResult;

    private string? errorMessage;

    private bool isAnalyzing;

    private void HandleFileSelected(
        InputFileChangeEventArgs eventArgs)
    {
        selectedFile =
            eventArgs.File;

        analysisResult =
            null;

        errorMessage =
            null;
    }

    private async Task AnalyzeFileAsync()
    {
        if (selectedFile is null)
        {
            errorMessage =
                "Please select a FIT file first.";

            return;
        }

        isAnalyzing =
            true;

        analysisResult =
            null;

        errorMessage =
            null;

        try
        {
            analysisResult =
                await ApiClient.AnalyzeFileAsync(
                    selectedFile,
                    CancellationToken.None);
        }
        catch (Exception exception)
        {
            errorMessage =
                $"The file could not be analyzed: {exception.Message}";
        }
        finally
        {
            isAnalyzing =
                false;
        }
    }
}