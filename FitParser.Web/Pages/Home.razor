@page "/"

@using FitParser.Web.Models
@using FitParser.Web.Services
@using Microsoft.AspNetCore.Components.Forms

@inject FitParserApiClient ApiClient
@inject NavigationManager Navigation

<PageTitle>FIT Parser</PageTitle>

<div class="fit-parser-page">
    @if (analysisResult is null)
    {
        <section class="upload-page">
            <div class="upload-card">
                <div class="title-row">
                    <h1>FIT Parser</h1>

                    <button class="info-button"
                            @onclick="ToggleInformation"
                            aria-label="More information">
                        i
                    </button>
                </div>

                <p class="subtitle">
                    Extract data from a Garmin FIT file for your research.
                </p>

                <div @key="uploadKey">
                    <label for="fit-file-input"
                           class="choose-file-button">
                        <span class="upload-icon">↑</span>
                        <span>Choose a FIT File</span>
                    </label>

                    <InputFile id="fit-file-input"
                               OnChange="HandleFileSelected"
                               accept=".fit"
                               class="hidden-file-input" />
                </div>

                @if (showInformation)
                {
                    <div class="information-panel">
                        <p>
                            This application extracts data from Garmin
                            <strong>.fit</strong> files.
                        </p>

                        <p>
                            FIT data is organized into messages, and each
                            message contains individual fields.
                        </p>

                        <p>
                            After analysis, you can choose which messages and
                            fields you want to export.
                        </p>
                    </div>
                }

                @if (selectedFile is not null)
                {
                    <div class="selected-file-panel">
                        <div class="file-name-container">
                            <span class="selected-file-label">
                                Selected file
                            </span>

                            <strong>@selectedFile.Name</strong>
                        </div>

                        <button class="remove-file-button"
                                @onclick="RemoveSelectedFile">
                            Delete File
                        </button>
                    </div>

                    <button class="analyze-button"
                            @onclick="AnalyzeFileAsync"
                            disabled="@isAnalyzing">

                        @if (isAnalyzing)
                        {
                            <span class="spinner"></span>
                            <span>Analyzing...</span>
                        }
                        else
                        {
                            <span>Analyze File</span>
                        }
                    </button>
                }

                @if (!string.IsNullOrWhiteSpace(errorMessage))
                {
                    <div class="error-message">
                        @errorMessage
                    </div>
                }
            </div>
        </section>
    }
    else
    {
        <section class="analysis-complete-page">
            <div class="analysis-card">
                <div class="success-icon">
                    ✓
                </div>

                <h1>File Analyzed Successfully</h1>

                <p class="subtitle">
                    Your FIT file is ready. Choose the messages and fields
                    you want to export.
                </p>

                <div class="analysis-summary">
                    <div class="summary-item">
                        <span>File Name</span>
                        <strong>@analysisResult.FileName</strong>
                    </div>

                    <div class="summary-item">
                        <span>Messages</span>
                        <strong>@analysisResult.MessageCount</strong>
                    </div>

                    <div class="summary-item">
                        <span>Message Types</span>
                        <strong>@analysisResult.Messages.Count</strong>
                    </div>
                </div>

                <button class="continue-button"
                        @onclick="ContinueToSelection">
                    Select Messages and Fields →
                </button>

                <button class="start-over-button"
                        @onclick="ReturnToUpload">
                    Analyze Another File
                </button>
            </div>
        </section>
    }
</div>

<style>
    .fit-parser-page {
        min-height: 100vh;
        background: #f4f6f9;
    }

    .upload-page,
    .analysis-complete-page {
        min-height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 2rem;
    }

    .upload-card,
    .analysis-card {
        width: 100%;
        max-width: 680px;
        padding: 3rem;
        text-align: center;
        background: white;
        border-radius: 1rem;
        box-shadow: 0 0.5rem 2rem rgba(0, 0, 0, 0.1);
    }

    .title-row {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 0.75rem;
    }

    h1 {
        margin-bottom: 1rem;
        color: #212529;
    }

    .subtitle {
        margin-bottom: 2rem;
        color: #6c757d;
        line-height: 1.6;
    }

    .info-button {
        width: 2rem;
        height: 2rem;
        padding: 0;
        border: 2px solid #0d6efd;
        border-radius: 50%;
        background: white;
        color: #0d6efd;
        font-size: 1.2rem;
        font-weight: bold;
        cursor: pointer;
    }

    .info-button:hover {
        background: #0d6efd;
        color: white;
    }

    .choose-file-button {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 0.75rem;
        width: 100%;
        min-height: 90px;
        margin-top: 2rem;
        padding: 1.5rem;
        border-radius: 0.75rem;
        background: #0d6efd;
        color: white;
        font-size: 1.35rem;
        font-weight: 600;
        cursor: pointer;
        box-shadow: 0 0.5rem 1rem rgba(13, 110, 253, 0.3);
    }

    .choose-file-button:hover {
        background: #0b5ed7;
        transform: translateY(-2px);
    }

    .upload-icon {
        font-size: 2rem;
        font-weight: bold;
    }

    .hidden-file-input {
        display: none;
    }

    .information-panel {
        margin-top: 1.5rem;
        padding: 1.25rem;
        text-align: left;
        color: #495057;
        background: #e9f2ff;
        border-left: 4px solid #0d6efd;
        border-radius: 0.5rem;
    }

    .information-panel p {
        margin-bottom: 0.75rem;
    }

    .information-panel p:last-child {
        margin-bottom: 0;
    }

    .selected-file-panel {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        margin-top: 1.5rem;
        padding: 1rem;
        text-align: left;
        background: #f8f9fa;
        border: 1px solid #dee2e6;
        border-radius: 0.5rem;
    }

    .file-name-container {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
        overflow: hidden;
    }

    .selected-file-label {
        color: #6c757d;
        font-size: 0.85rem;
    }

    .remove-file-button,
    .start-over-button {
        padding: 0.65rem 0.9rem;
        border: 1px solid #dc3545;
        border-radius: 0.375rem;
        background: white;
        color: #dc3545;
        cursor: pointer;
        white-space: nowrap;
    }

    .remove-file-button:hover,
    .start-over-button:hover {
        background: #dc3545;
        color: white;
    }

    .analyze-button,
    .continue-button {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 0.75rem;
        width: 100%;
        margin-top: 1rem;
        padding: 0.9rem;
        border: none;
        border-radius: 0.5rem;
        background: #198754;
        color: white;
        font-size: 1.1rem;
        font-weight: 600;
        cursor: pointer;
    }

    .analyze-button:hover,
    .continue-button:hover {
        background: #157347;
    }

    .analyze-button:disabled {
        opacity: 0.7;
        cursor: not-allowed;
    }

    .error-message {
        margin-top: 1.25rem;
        padding: 1rem;
        border-radius: 0.5rem;
        background: #f8d7da;
        color: #842029;
    }

    .success-icon {
        display: flex;
        justify-content: center;
        align-items: center;
        width: 4rem;
        height: 4rem;
        margin: 0 auto 1.25rem;
        border-radius: 50%;
        background: #d1e7dd;
        color: #198754;
        font-size: 2.5rem;
        font-weight: bold;
    }

    .analysis-summary {
        display: grid;
        grid-template-columns: 2fr 1fr 1fr;
        gap: 1rem;
        margin: 2rem 0;
        text-align: left;
    }

    .summary-item {
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
        padding: 1rem;
        overflow: hidden;
        background: #f8f9fa;
        border-radius: 0.5rem;
    }

    .summary-item span {
        color: #6c757d;
        font-size: 0.85rem;
    }

    .start-over-button {
        margin-top: 1rem;
        border-color: #6c757d;
        color: #6c757d;
    }

    .start-over-button:hover {
        background: #6c757d;
        color: white;
    }

    .spinner {
        width: 1.25rem;
        height: 1.25rem;
        border: 3px solid #b7e4c7;
        border-top-color: white;
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
    }

    @@keyframes spin {
        to {
            transform: rotate(360deg);
        }
    }

    @@media (max-width: 700px) {
        .upload-card,
        .analysis-card {
            padding: 2rem 1.5rem;
        }

        .selected-file-panel {
            align-items: stretch;
            flex-direction: column;
        }

        .analysis-summary {
            grid-template-columns: 1fr;
        }
    }
</style>

@code {
    private IBrowserFile? selectedFile;

    private AnalyzeFitResponse? analysisResult;

    private string? errorMessage;

    private bool isAnalyzing;

    private bool showInformation;

    private int uploadKey;

    private void HandleFileSelected(
        InputFileChangeEventArgs eventArgs)
    {
        selectedFile =
            eventArgs.File;

        analysisResult =
            null;

        errorMessage =
            null;
    }

    private void RemoveSelectedFile()
    {
        selectedFile =
            null;

        analysisResult =
            null;

        errorMessage =
            null;

        uploadKey++;
    }

    private async Task AnalyzeFileAsync()
    {
        if (selectedFile is null)
        {
            errorMessage =
                "Please select a FIT file first.";

            return;
        }

        isAnalyzing =
            true;

        errorMessage =
            null;

        try
        {
            analysisResult =
                await ApiClient.AnalyzeFileAsync(
                    selectedFile,
                    CancellationToken.None);
        }
        catch (Exception exception)
        {
            errorMessage =
                $"The file could not be analyzed: " +
                $"{exception.Message}";
        }
        finally
        {
            isAnalyzing =
                false;
        }
    }

    private void ContinueToSelection()
    {
        if (analysisResult is null)
        {
            return;
        }

        Navigation.NavigateTo(
            "/selection");
    }

    private void ReturnToUpload()
    {
        selectedFile =
            null;

        analysisResult =
            null;

        ApiClient.ClearAnalysis();

        errorMessage =
            null;

        showInformation =
            false;

        uploadKey++;
    }

    private void ToggleInformation()
    {
        showInformation =
            !showInformation;
    }
}