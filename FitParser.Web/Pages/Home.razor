@page "/"

@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@using FitParser.Web.Services

@inject FitParserApiClient ApiClient
@inject IJSRuntime JavaScript

<PageTitle>FIT Parser</PageTitle>

<h1>FIT Parser</h1>

<p>Choose a FIT file to analyze or export.</p>

<InputFile
    OnChange="HandleFileSelected"
    accept=".fit" />

@if (_selectedFile is not null)
{
    <p>
        Selected file:
        <strong>@_selectedFile.Name</strong>
    </p>

    <button
        @onclick="AnalyzeFileAsync"
        disabled="@_isAnalyzing">
        @(_isAnalyzing ? "Analyzing..." : "Analyze File")
    </button>

    <button
        @onclick="ExportAllAsync"
        disabled="@_isExporting">
        @(_isExporting ? "Exporting..." : "Export All Data")
    </button>
}

@if (!string.IsNullOrWhiteSpace(_statusMessage))
{
    <p>@_statusMessage</p>
}

@if (!string.IsNullOrWhiteSpace(_errorMessage))
{
    <p style="color: red;">
        @_errorMessage
    </p>
}

@if (_analysis is not null && _analysis.IsSuccess)
{
    <hr />

    <h2>Messages</h2>

    <table>
        <thead>
            <tr>
                <th>Number</th>
                <th>Name</th>
                <th>Occurrences</th>
            </tr>
        </thead>

        <tbody>
            @foreach (AvailableMessageModel message
                in _analysis.Messages)
            {
                <tr>
                    <td>@message.MessageNumber</td>
                    <td>@message.MessageName</td>
                    <td>@message.Count</td>
                </tr>
            }
        </tbody>
    </table>

    <h2>Fields</h2>

    <table>
        <thead>
            <tr>
                <th>Message</th>
                <th>Message Number</th>
                <th>Field</th>
                <th>Field Number</th>
                <th>Occurrences</th>
            </tr>
        </thead>

        <tbody>
            @foreach (AvailableFieldModel field
                in _analysis.Fields)
            {
                <tr>
                    <td>@field.MessageName</td>
                    <td>@field.MessageNumber</td>
                    <td>@field.FieldName</td>
                    <td>@field.FieldNumber</td>
                    <td>@field.Count</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private IBrowserFile? _selectedFile;

    private AnalyzeResponse? _analysis;

    private bool _isAnalyzing;

    private bool _isExporting;

    private string? _statusMessage;

    private string? _errorMessage;

    private void HandleFileSelected(
        InputFileChangeEventArgs eventArgs)
    {
        _selectedFile = eventArgs.File;
        _analysis = null;
        _statusMessage = null;
        _errorMessage = null;
    }

    private async Task AnalyzeFileAsync()
    {
        if (_selectedFile is null)
        {
            return;
        }

        _isAnalyzing = true;
        _statusMessage = "Analyzing FIT file...";
        _errorMessage = null;

        try
        {
            AnalyzeResponse response =
                await ApiClient.AnalyzeAsync(
                    _selectedFile);

            if (!response.IsSuccess)
            {
                _analysis = null;
                _statusMessage = null;
                _errorMessage =
                    response.ErrorMessage
                    ?? "The file could not be analyzed.";

                return;
            }

            _analysis = response;
            _statusMessage =
                "The FIT file was analyzed successfully.";
        }
        catch (Exception exception)
        {
            _statusMessage = null;
            _errorMessage = exception.Message;
        }
        finally
        {
            _isAnalyzing = false;
        }
    }

    private async Task ExportAllAsync()
    {
        if (_selectedFile is null)
        {
            return;
        }

        _isExporting = true;
        _statusMessage = "Exporting all data...";
        _errorMessage = null;

        try
        {
            ExportResponse response =
                await ApiClient.ExportAllAsync(
                    _selectedFile);

            if (!response.IsSuccess ||
                response.CsvBytes is null)
            {
                _statusMessage = null;
                _errorMessage =
                    response.ErrorMessage
                    ?? "The file could not be exported.";

                return;
            }

            string base64Data =
                Convert.ToBase64String(
                    response.CsvBytes);

            await JavaScript.InvokeVoidAsync(
                "downloadFile",
                "fit-export.csv",
                "text/csv",
                base64Data);

            _statusMessage =
                "The FIT file was exported successfully.";
        }
        catch (Exception exception)
        {
            _statusMessage = null;
            _errorMessage = exception.Message;
        }
        finally
        {
            _isExporting = false;
        }
    }
}